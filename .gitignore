# Upstream checkouts and build output live outside the repo; never commit them.
/onlyoffice-src/
/build_tools/
/out/
/logs/

# Installer artifacts are produced per-host by scripts/package.sh.
/artifacts/*
!/artifacts/.gitkeep

node_modules/
__pycache__/
*.pyc

# Fixture server working dir
/tests/fixtures/*.tmp

# Generated by scripts/gen_env.sh — contains live credentials.
/deploy/.env

# Generated by scripts/gen_tls_cert.sh — contains a private key.
/deploy/tls/
