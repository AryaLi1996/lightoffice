#if !defined(BOOST_MPL_AUX_ENUM_SAFE_STEP_DEFINED) \
    && defined(__cplusplus) && (__cplusplus >= 201103L)
#   define BOOST_MPL_AUX_ENUM_SAFE_STEP_DEFINED
#   define BOOST_MPL_AUX_ENUM_SAFE_STEP
namespace boost { namespace mpl { namespace aux {
template< typename T, bool IsEnum = __is_enum(T) >
struct wrapper_step
{
    static constexpr T next(T v) { return static_cast<T>(v + 1); }
    static constexpr T prior(T v) { return static_cast<T>(v - 1); }
};
template< typename T >
struct wrapper_step< T, true >
{
    static constexpr T next(T v) { return v; }
    static constexpr T prior(T v) { return v; }
};
} } }
#endif

